COMPOSE_FILE=compose.yaml

GH_PAGER=""

RUST_BACKTRACE=1
RUST_LOG=warn,tansu_broker=debug,tansu_storage=debug

TANSU_IMAGE=ghcr.io/popsink/tansu

# Kafka cluster:
CLUSTER_ID="tansu"

ADVERTISED_LISTENER="localhost:9092"
ADVERTISED_LISTENER_URL="tcp://${ADVERTISED_LISTENER}"

# create an access key for minio at:
# http://localhost:9001/access-keys
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"

AWS_DEFAULT_REGION="eu-west-2"

# use this endpoint when tansu and minio are both running in docker compose:
AWS_ENDPOINT="http://minio:9000"

# use this endpoint when running tansu directly from the command line with
# minio running in compose
# AWS_ENDPOINT="http://localhost:9000"

# enable http requests for a local minio
AWS_ALLOW_HTTP="true"

# minio storage engine
# create a bucket "tansu" at: http://localhost:9001/buckets
# or: mc mb local/tansu
STORAGE_ENGINE="s3://tansu/"

# memory storage engine
# STORAGE_ENGINE="memory://tansu/"

# Azure Data Lake Storage Gen2 (docs/adls.md). Experimental.
#
# `abfss://` is canonical and carries the account; `az://tansu/` is the short
# form and takes it from AZURE_STORAGE_ACCOUNT_NAME.
# STORAGE_ENGINE="abfss://tansu@myaccount.dfs.core.windows.net/"
# AZURE_STORAGE_ACCOUNT_NAME="myaccount"
#
# Credentials: one of the sets below. Whichever you use, the identity needs the
# `Storage Blob Data Contributor` role — `Owner` is an ARM role and grants no
# data-plane access, which is the first thing that goes wrong.
#
# Workload identity federation, the AKS path and the analogue of IRSA. Nothing
# to rotate; prefer it.
# AZURE_FEDERATED_TOKEN_FILE="/var/run/secrets/azure/tokens/azure-identity-token"
# AZURE_STORAGE_CLIENT_ID="00000000-0000-0000-0000-000000000000"
# AZURE_STORAGE_TENANT_ID="00000000-0000-0000-0000-000000000000"
#
# Account key, for a quick trial rather than a deployment.
# AZURE_STORAGE_ACCOUNT_KEY=""
#
# Azurite, for local work. Set by `just broker-az` rather than here on purpose:
# it rewrites the account to Azurite's development pair and the endpoint to
# localhost, and unlike AWS_ENDPOINT a stray copy of it fails silently.
# AZURE_STORAGE_USE_EMULATOR="true"

# Default topic config applied when a topic is created without one (Kafka
# defaults: cleanup.policy=delete, retention.ms=604800000 / 7 days). Set
# DEFAULT_CLEANUP_POLICY="" to opt out and keep topics forever unless the
# client sets cleanup.policy explicitly.
# DEFAULT_CLEANUP_POLICY="delete"
# DEFAULT_RETENTION="7days"

# Client quotas applied to a principal the cluster's own quotas name neither
# specifically nor by default (docs/quotas.md). Inert without --authentication:
# no principal, no quota. Omit for no limit; -1 is refused rather than read as
# unlimited.
# QUOTA_PRODUCER_BYTE_RATE="1048576"
# QUOTA_CONSUMER_BYTE_RATE="4194304"
# QUOTA_REQUEST_RATE="500"

# How many replicas a configured quota is shared between. 1 enforces each limit
# on every replica, as Apache Kafka does; higher reads a limit as fleet-wide and
# divides it, which is approximate while the fleet is scaling.
# QUOTA_FLEET_SIZE="1"

# Largest request frame the listener will read, Kafka's socket.request.max.bytes.
# A size in the IEC units the storage keys use (100M is 100MiB, 8m is 8MiB) or a
# byte count; 0 or "unlimited" reads whatever a client announces. Raise it with
# message_max_bytes, or a legitimately oversized produce has its connection
# closed instead of being answered.
# SOCKET_REQUEST_MAX_BYTES="100M"

# Close a connection with no request in flight and nothing read for this many
# milliseconds, Kafka's connections.max.idle.ms. A long-poll Fetch or a produce
# waiting on its window is in flight and never cut. 0 never closes one.
# CONNECTIONS_MAX_IDLE_MS="600000"

# TCP keepalive on client connections, so one whose client vanished without a
# FIN or RST is reaped: probe after TCP_KEEPALIVE_SECS of silence (0 turns it
# off), every TCP_KEEPALIVE_INTERVAL_SECS, reset after TCP_KEEPALIVE_RETRIES
# unanswered probes.
# TCP_KEEPALIVE_SECS="60"
# TCP_KEEPALIVE_INTERVAL_SECS="10"
# TCP_KEEPALIVE_RETRIES="3"

# group.protocol=consumer (KIP-848) groups: the session a member is held to,
# how often it is told to heartbeat (less than the session), and the most
# members a group admits (0 is unbounded). Kafka's group.consumer.* defaults.
# GROUP_CONSUMER_SESSION_TIMEOUT_MS="45000"
# GROUP_CONSUMER_HEARTBEAT_INTERVAL_MS="5000"
# GROUP_CONSUMER_MAX_SIZE="0"

# Whether a running classic group may become a group.protocol=consumer group
# when its members are restarted one at a time with the consumer protocol:
# upgrade (the default) or disabled.
# GROUP_CONSUMER_MIGRATION_POLICY="upgrade"
